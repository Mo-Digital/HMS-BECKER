---
import Icon from './Icon.astro';
import type { Service } from '../data/services';
interface Props {
  service: Service;
  index?: number;
}
const { service: s, index = 0 } = Astro.props;
---
<a href={`/leistungen/${s.slug}/`} class="svc card group relative grid h-full grid-cols-[auto_1fr] gap-x-4 overflow-hidden p-5 no-underline sm:flex sm:flex-col sm:p-6" data-reveal style={`--reveal-delay:${(index % 3) * 80}ms`}>
  <span class="svc-icon row-span-3 grid size-12 place-items-center rounded-2xl bg-surface-alt text-brand-ink transition-colors duration-300 sm:size-14">
    <Icon name={s.icon} class="size-6 sm:size-7" strokeWidth={1.75} />
  </span>
  <h3 class="text-lg font-extrabold text-ink sm:mt-5 sm:text-xl">{s.title}</h3>
  <p class="mt-1 flex-1 text-[0.95rem] text-muted sm:mt-2 sm:text-base">{s.teaser}</p>
  <span class="mt-3 inline-flex items-center gap-1.5 font-display font-bold text-brand-ink sm:mt-5">
    Mehr erfahren <Icon name="ArrowRight" class="size-4 transition-transform duration-300 group-hover:translate-x-1" />
  </span>
  {s.emergency && <span class="absolute top-4 right-4 rounded-full sm:top-5 sm:right-5 bg-signal-btn px-2.5 py-1 text-xs font-bold text-white">Notfall</span>}
</a>
<style>
  .svc {
    transition:
      transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 0.35s,
      border-color 0.35s;
  }
  .svc::before {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 4px;
    background: linear-gradient(90deg, var(--hms-blue), var(--hms-signal));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .svc:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lift);
    border-color: transparent;
  }
  .svc:hover::before {
    transform: scaleX(1);
  }
  .svc:hover .svc-icon {
    background: var(--hms-blue);
    color: #fff;
  }
</style>
