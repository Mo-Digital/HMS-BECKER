---
/** Feste Anruf-Leiste unten – nur auf dem Handy */
import Icon from './Icon.astro';
import { site } from '../data/site';
---
<div class="callbar fixed inset-x-0 bottom-0 z-40 border-t border-white/10 bg-hms-navy/95 px-3 pt-2 backdrop-blur md:hidden" style="padding-bottom: max(0.5rem, env(safe-area-inset-bottom))">
  <div class="grid grid-cols-[1fr_auto_auto] gap-2">
    <a href={site.phone.href} class="btn btn-signal !min-h-12 !text-base"><Icon name="Phone" class="size-5" /> Jetzt anrufen</a>
    <a href="/kontakt/#anfrage" class="grid size-12 place-items-center rounded-full bg-white/10 text-white" aria-label="Angebot anfragen"><Icon name="Mail" class="size-5" /></a>
    <a href={site.mobile.href} class="grid size-12 place-items-center rounded-full bg-white/10 text-white" aria-label={`Notfall-Nummer anrufen: ${site.mobile.display}`}><Icon name="Siren" class="size-5" /></a>
  </div>
</div>
