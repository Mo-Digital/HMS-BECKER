<style>
  .logo {
    --logo-mark-bg: var(--hms-blue);
    --logo-mark-fg: #fff;
    color: var(--c-brand-ink);
  }
  .logo-top {
    color: var(--c-ink);
  }
  .logo--light {
    --logo-mark-bg: #fff;
    --logo-mark-fg: var(--hms-blue);
    color: #fff;
  }
  .logo--light .logo-top {
    color: var(--hms-ice);
  }
  :global([data-theme='dark']) .logo--auto {
    --logo-mark-bg: #fff;
    --logo-mark-fg: var(--hms-blue);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .logo--auto {
      --logo-mark-bg: #fff;
      --logo-mark-fg: var(--hms-blue);
    }
  }
</style>
