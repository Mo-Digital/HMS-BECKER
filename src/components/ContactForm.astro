---
/**
 * Kontaktformular → public/send.php (PHP auf Ihrem Webspace).
 * Funktioniert auch ohne JavaScript; mit JS wird ohne Seitenwechsel gesendet.
 * Spamschutz: unsichtbares Honeypot-Feld + Mindest-Ausfüllzeit (in send.php).
 */
import Icon from './Icon.astro';
import { services } from '../data/services';

interface Props {
  preselect?: string;
}
const { preselect = '' } = Astro.props;
const options = [
  ...services.map((s) => ({ value: s.title, slug: s.slug })),
  { value: 'Bewerbung / Stellenangebot', slug: 'bewerbung' },
  { value: 'Sonstiges', slug: 'sonstiges' },
];
---
<form id="anfrage" action="/send.php" method="post" class="cf card space-y-5 p-6 sm:p-8" novalidate>
  <div class="grid gap-5 sm:grid-cols-2">
    <div class="field sm:col-span-2">
      <label for="cf-name">Name <span aria-hidden="true">*</span></label>
      <input id="cf-name" name="name" type="text" autocomplete="name" required maxlength="120" />
      <p class="err" id="cf-name-err">Bitte geben Sie Ihren Namen an.</p>
    </div>
    <div class="field">
      <label for="cf-phone">Telefon</label>
      <input id="cf-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="40" aria-describedby="cf-contact-hint" />
    </div>
    <div class="field">
      <label for="cf-email">E-Mail</label>
      <input id="cf-email" name="email" type="email" autocomplete="email" maxlength="160" aria-describedby="cf-contact-hint" />
      <p class="err" id="cf-email-err">Bitte prüfen Sie die E-Mail-Adresse.</p>
    </div>
    <p id="cf-contact-hint" class="-mt-3 text-sm text-muted sm:col-span-2">Bitte Telefon <strong>oder</strong> E-Mail angeben, damit wir Sie erreichen.</p>
    <p class="err sm:col-span-2" id="cf-contact-err">Bitte geben Sie eine Telefonnummer oder E-Mail-Adresse an.</p>
    <div class="field sm:col-span-2">
      <label for="cf-service">Worum geht es?</label>
      <div class="relative">
        <select id="cf-service" name="service" class="appearance-none pr-10">
          <option value="">Bitte wählen …</option>
          {options.map((o) => <option value={o.value} data-slug={o.slug} selected={o.slug === preselect}>{o.value}</option>)}
        </select>
        <Icon name="ChevronDown" class="pointer-events-none absolute top-1/2 right-3 size-5 -translate-y-1/2 text-muted" />
      </div>
    </div>
    <div class="field sm:col-span-2">
      <label for="cf-msg">Ihre Nachricht <span aria-hidden="true">*</span></label>
      <textarea id="cf-msg" name="message" rows="6" required maxlength="5000" placeholder="z. B. Objektart, Adresse/Stadtteil, gewünschter Zeitraum …"></textarea>
      <p class="err" id="cf-msg-err">Bitte schreiben Sie uns kurz, worum es geht.</p>
    </div>
  </div>

  <!-- Honeypot: für Menschen unsichtbar – bitte leer lassen -->
  <div class="hp" aria-hidden="true">
    <label for="cf-website">Website (bitte leer lassen)</label>
    <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <input type="hidden" name="t" value="" data-ts />

  <div class="field-check">
    <input id="cf-privacy" name="privacy" type="checkbox" value="1" required />
    <label for="cf-privacy">
      Ich bin einverstanden, dass meine Angaben zur Bearbeitung der Anfrage verwendet werden. Details in der <a href="/datenschutz/" class="font-semibold text-brand-ink underline">Datenschutzerklärung</a>. <span aria-hidden="true">*</span>
    </label>
  </div>
  <p class="err" id="cf-privacy-err">Bitte stimmen Sie der Datenverarbeitung zu.</p>

  <div class="flex flex-col gap-4 pt-2 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm text-muted">* Pflichtfeld</p>
    <button type="submit" class="btn btn-signal">
      <span class="cf-label">Anfrage senden</span>
      <Icon name="Send" class="size-5" />
    </button>
  </div>
  <div class="cf-status hidden rounded-2xl p-4 font-semibold" role="status" aria-live="polite"></div>
</form>

<style>
  .field label,
  .field-check label {
    display: block;
    font-weight: 600;
    margin-bottom: 0.4rem;
    color: var(--c-ink);
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    border-radius: 0.9rem;
    border: 1.5px solid var(--c-line);
    background: var(--c-bg);
    color: var(--c-ink);
    padding: 0.85rem 1rem;
    font-size: 1rem;
    min-height: 3.25rem;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--hms-blue);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--hms-blue) 22%, transparent);
  }
  :global([data-theme='dark']) .field input:focus,
  :global([data-theme='dark']) .field select:focus,
  :global([data-theme='dark']) .field textarea:focus {
    border-color: var(--c-brand-ink);
  }
  .field [aria-invalid='true'] {
    border-color: var(--c-signal-ink);
  }
  .field-check {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }
  .field-check input {
    margin-top: 0.2rem;
    width: 1.35rem;
    height: 1.35rem;
    flex-shrink: 0;
    accent-color: var(--hms-blue);
  }
  .field-check label {
    font-weight: 400;
  }
  .err {
    display: none;
    margin-top: 0.35rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--c-signal-ink);
  }
  .err.show {
    display: block;
  }
  .hp {
    position: absolute !important;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .cf-status.ok {
    display: block;
    background: color-mix(in srgb, #1f9d55 14%, transparent);
    color: var(--c-ink);
  }
  .cf-status.bad {
    display: block;
    background: color-mix(in srgb, var(--hms-signal) 14%, transparent);
    color: var(--c-ink);
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('form.cf');
  if (form) {
    const ts = form.querySelector<HTMLInputElement>('[data-ts]')!;
    ts.value = String(Math.floor(Date.now() / 1000));

    // Leistung aus URL vorauswählen: /kontakt/?leistung=winterdienst
    const pre = new URLSearchParams(location.search).get('leistung');
    if (pre) {
      const opt = form.querySelector<HTMLOptionElement>(`option[data-slug="${CSS.escape(pre)}"]`);
      if (opt) opt.selected = true;
    }

    const $ = (id: string) => form.querySelector<HTMLInputElement>('#' + id)!;
    const show = (id: string, on: boolean, field?: HTMLElement) => {
      form.querySelector('#' + id)?.classList.toggle('show', on);
      if (field) {
        field.setAttribute('aria-invalid', String(on));
        if (on) field.setAttribute('aria-errormessage', id);
      }
    };
    const validate = () => {
      const name = $('cf-name'), email = $('cf-email'), phone = $('cf-phone'), msg = $('cf-msg'), priv = $('cf-privacy');
      const badName = name.value.trim().length < 2;
      const badEmail = email.value.trim() !== '' && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email.value.trim());
      const noContact = email.value.trim() === '' && phone.value.trim().length < 5;
      const badMsg = msg.value.trim().length < 5;
      const badPriv = !priv.checked;
      show('cf-name-err', badName, name);
      show('cf-email-err', badEmail, email);
      show('cf-contact-err', noContact, phone);
      show('cf-msg-err', badMsg, msg);
      show('cf-privacy-err', badPriv, priv);
      const first = [badName && name, (badEmail || noContact) && (badEmail ? email : phone), badMsg && msg, badPriv && priv].find(Boolean) as HTMLElement | undefined;
      first?.focus();
      return !first;
    };

    const status = form.querySelector<HTMLElement>('.cf-status')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const label = btn.querySelector('.cf-label')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!validate()) return;
      btn.disabled = true;
      label.textContent = 'Wird gesendet …';
      status.className = 'cf-status';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const data = await res.json().catch(() => ({ ok: false, message: '' }));
        if (res.ok && data.ok) {
          status.className = 'cf-status ok';
          status.textContent = 'Vielen Dank! Ihre Anfrage ist bei uns angekommen. Wir melden uns schnellstmöglich.';
          form.reset();
          ts.value = String(Math.floor(Date.now() / 1000));
        } else {
          throw new Error(data.message || 'Fehler');
        }
      } catch (err) {
        status.className = 'cf-status bad';
        const msg = err instanceof Error && err.message && err.message !== 'Fehler' && err.message !== 'Failed to fetch' ? err.message + ' ' : '';
        status.textContent = `Das hat leider nicht geklappt. ${msg}Bitte rufen Sie uns an: 07131 / 62 82 20 oder schreiben Sie an info@hms-becker.de.`;
      } finally {
        btn.disabled = false;
        label.textContent = 'Anfrage senden';
        status.focus?.();
      }
    });
  }
</script>
