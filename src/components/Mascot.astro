---
/**
 * Maskottchen „Kehrwöchle“ (Arbeitstitel) – die weiße Figur mit verschränkten Armen.
 * PLATZHALTER: Diese Vektor-Zeichnung ist nur eine Interpretation des alten Maskottchens.
 * Sobald die bessere Version da ist: Datei als src/assets/fotos/maskottchen.png
 * (transparent, mind. 600 px hoch) ablegen – sie ersetzt die Zeichnung automatisch.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../data/site';

interface Props {
  class?: string;
  label?: boolean;
}
const { class: className = '', label = true } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/fotos/maskottchen.{png,webp,avif,jpg}', { eager: true });
const img = Object.values(files)[0]?.default;
---
<figure class:list={['mascot relative', className]}>
  {
    img ? (
      <Image src={img} alt="Maskottchen von Hausmeister-Service Becker" widths={[200, 400]} sizes="200px" class="h-auto w-full" loading="lazy" />
    ) : (
      <svg viewBox="0 0 160 210" class="h-auto w-full overflow-visible" role="img" aria-label="Maskottchen von Hausmeister-Service Becker: weiße Figur mit verschränkten Armen">
        <ellipse cx="80" cy="202" rx="44" ry="6" fill="currentColor" opacity=".18" />
        <g stroke="#0b1030" stroke-width="4" stroke-linejoin="round" stroke-linecap="round" fill="#fff">
          <path d="M60 150c-2 18-4 30-6 42 6 4 18 4 22 0l4-36M100 150c2 18 4 30 6 42-6 4-18 4-22 0l-4-36" />
          <path d="M50 108c0-20 12-30 30-30s30 10 30 30v40c0 12-12 18-30 18s-30-6-30-18z" />
          <g class="mascot-head">
            <path d="M80 8c22 0 38 16 38 38 0 20-15 36-37 36S43 66 43 46 58 8 80 8z" />
            <ellipse cx="70" cy="40" rx="4.5" ry="6.5" fill="#0b1030" stroke="none" />
            <ellipse cx="92" cy="38" rx="4.5" ry="6.5" fill="#0b1030" stroke="none" />
            <path d="M66 58c8 7 20 7 28-2" fill="none" />
          </g>
          <path d="M44 112c8-6 22-6 34-2l30 8c6 2 6 14-2 16l-30-4c-14-2-28-2-34-6-4-3-3-9 2-12z" />
          <path d="M116 112c-8-6-22-6-34-2l-24 10c-6 2-4 14 4 14l26-6c14-3 26-2 30-6 3-3 3-8-2-10z" />
        </g>
      </svg>
    )
  }
  {!img && label && site.showPlaceholderLabels && (
    <figcaption class="mt-1 text-center text-[0.65rem] font-semibold tracking-wider uppercase opacity-70">Platzhalter Maskottchen</figcaption>
  )}
</figure>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .mascot .mascot-head {
      transform-origin: 80px 80px;
      transition: transform 0.5s cubic-bezier(0.3, 1.6, 0.5, 1);
    }
    .mascot:hover .mascot-head {
      transform: rotate(-8deg);
    }
  }
</style>
