---
import Icon from './Icon.astro';
import { site } from '../data/site';
interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Sprechen wir über Ihr Objekt.',
  text = 'Angebote erstellen wir individuell – denn kein Objekt gleicht dem anderen. Rufen Sie an oder schreiben Sie uns.',
} = Astro.props;
---
<section class="container-x mt-24" aria-labelledby="cta-title">
  <div class="sweep-pattern relative overflow-hidden rounded-[2rem] bg-hms-blue px-6 py-12 text-white sm:px-12 md:py-16" data-reveal>
    <div class="pointer-events-none absolute -top-24 -right-24 size-72 rounded-full bg-ice/10 blur-2xl" aria-hidden="true"></div>
    <div class="relative grid items-center gap-8 lg:grid-cols-[1.4fr_1fr]">
      <div>
        <h2 id="cta-title" class="h-section text-white">{title}</h2>
        <p class="mt-4 max-w-xl text-lg text-ice">{text}</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row lg:flex-col lg:items-end">
        <a href={site.phone.href} class="btn btn-signal !text-lg"><Icon name="Phone" class="size-5" /> {site.phone.display}</a>
        <a href="/kontakt/#anfrage" class="btn btn-ghost-light">Angebot anfragen <Icon name="ArrowRight" class="size-5" /></a>
      </div>
    </div>
  </div>
</section>
