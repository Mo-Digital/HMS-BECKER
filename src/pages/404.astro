---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import KehrwocheSign from '../components/KehrwocheSign.astro';
import { services } from '../data/services';
---
<Base title="Seite nicht gefunden" description="Diese Seite gibt es nicht (mehr)." noindex>
  <section class="container-x grid items-center gap-12 py-16 md:py-24 lg:grid-cols-2">
    <div>
      <p class="eyebrow">Fehler 404</p>
      <h1 class="mt-3 text-[clamp(2.5rem,1.6rem+4vw,4.5rem)] font-black">Hier wurde wohl zu gründlich gekehrt.</h1>
      <p class="mt-5 text-lg text-muted">Die gesuchte Seite gibt es nicht (mehr). Vielleicht finden Sie hier, was Sie suchen:</p>
      <ul class="mt-6 flex flex-wrap gap-2">
        {services.map((s) => <li><a href={`/leistungen/${s.slug}/`} class="inline-flex items-center gap-2 rounded-full bg-surface-alt px-4 py-2 font-semibold hover:text-brand-ink"><Icon name={s.icon} class="size-4" />{s.title}</a></li>)}
      </ul>
      <a href="/" class="btn btn-primary mt-8"><Icon name="House" class="size-5" /> Zur Startseite</a>
    </div>
    <div class="flex justify-center rounded-[2rem] bg-hms-blue px-6 pt-4 pb-12 sweep-pattern"><KehrwocheSign /></div>
  </section>
</Base>
